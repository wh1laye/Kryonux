{
    "$schema": "https://github.com",
    "logo": {
        "type": "data",
        "source": "$4%%%%%%%%         %%%%%%%%%\n$4%%$1.....$4=%       %%%$2=====$4#%%\n$4%%$1.....$4=%%%   %%%$2=====$4%%%%%\n$4%%$1.....$4=%%%  %%%$2=====$4%%%%%\n$4%%$1.....$4=%%%%%%+$2=====$4%%%%%\n$4%%$1.....$4=%%%%$2=====$4%%%%%\n$4%%$1...$4%%%%$3::$4%%$2=$4%%%%%\n$4%%%%$3::::::::::$4%%%\n$4%%-$3::::$4%$3::::::$4#%%%\n$4%%-$3::::$4%%%$3::::::$4%%%\n$4%%-$3::::$4%%%%-$3:::::$4%%%\n$4%%-$3::::$4%%%  %%%$3:::::$4%%%\n$4%%-$3::::$4%%%   %%%#$3:::::$4%%%\n$4%%-$3::::$4%%%    %%%$3:::::$4-%%%\n$4%%%%%%%%%       %%%%%%%%%%\n   $4%%%%%%          %%%%%%%",
        "color": {
            "1": "38;5;195",
            "2": "38;5;75",
            "3": "38;5;117",
            "4": "38;5;18"
        },
        "padding": {
            "top": 0,
            "left": 2,
            "right": 3
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "38;5;117",
            "title": "38;5;75",
            "separator": "38;5;240"
        },
        "key": {
            "width": 13
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{#38;5;75}{user-name}{#38;5;250}@{#38;5;117}{host-name}"
        },
        {
            "type": "separator",
            "string": "─"
        },
        {
            "type": "os",
            "key": " OS",
            "keyColor": "38;5;75"
        },
        {
            "type": "kernel",
            "key": " Kernel",
            "keyColor": "38;5;75"
        },
        {
            "type": "packages",
            "key": "   Packages",
            "keyColor": "38;5;117"
        },
        {
            "type": "shell",
            "key": " Shell",
            "keyColor": "38;5;117"
        },
        {
            "type": "wm",
            "key": " WM",
            "keyColor": "38;5;111"
        },
        {
            "type": "terminal",
            "key": " Terminal",
            "keyColor": "38;5;111"
        },
