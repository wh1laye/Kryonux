#!/bin/bash
set -eu
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
[ "$(id -u)" = 0 ] || { echo "root is required: doas kryonux-adduser name" >&2; exit 1; }
n=${1:-}
case $n in ''|*[!a-z0-9_-]*|[0-9-]*) echo "usage: kryonux-adduser name [nowheel]" >&2; exit 1 ;; esac
command -v useradd >/dev/null || { echo "useradd is missing: run kryonux-users" >&2; exit 1; }
g=wheel
[ "${2:-}" = nowheel ] && g=users
getent group "$g" >/dev/null || groupadd "$g"
useradd -m -G "$g" -s /bin/bash "$n"
passwd "$n"
echo "done: su - $n"
