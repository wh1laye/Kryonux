From: The Kryonux Project
Subject: [PATCH] security: kryonk: add the kernel.kryonk.lock sysctl

Adds a one-way sysctl. Writing 1 re-asserts the guard defaults and disables module loading until reboot. The value cannot be changed afterwards.
---
diff --git a/security/kryonk/Makefile b/security/kryonk/Makefile
--- a/security/kryonk/Makefile
+++ b/security/kryonk/Makefile
@@ -1 +1,2 @@
 obj-$(CONFIG_SECURITY_KRYONK)	+= kryonk.o
+obj-$(CONFIG_SECURITY_KRYONK)	+= kryonk_lock.o
diff --git a/security/kryonk/kryonk_lock.c b/security/kryonk/kryonk_lock.c
--- a/security/kryonk/kryonk_lock.c
+++ b/security/kryonk/kryonk_lock.c
@@ -0,0 +1,54 @@
+#include <linux/errno.h>
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/printk.h>
+#include <linux/sysctl.h>
+
+extern int kptr_restrict;
+extern int dmesg_restrict;
+extern int panic_on_oops;
+#ifdef CONFIG_MODULES
+extern int modules_disabled;
+#endif
+
+int kryonk_locked;
+
+static int kryonk_lock_handler(const struct ctl_table *table, int write,
+			       void *buffer, size_t *lenp, loff_t *ppos)
+{
+	int ret;
+
+	if (write && kryonk_locked)
+		return -EPERM;
+	ret = proc_dointvec_minmax(table, write, buffer, lenp, ppos);
+	if (write && !ret && kryonk_locked) {
+		kptr_restrict = 2;
+		dmesg_restrict = 1;
+		panic_on_oops = 1;
+#ifdef CONFIG_MODULES
+		modules_disabled = 1;
+#endif
+		pr_info("kryonk: locked, module loading is disabled\n");
+	}
+	return ret;
+}
+
+static const struct ctl_table kryonk_table[] = {
+	{
+		.procname	= "lock",
+		.data		= &kryonk_locked,
+		.maxlen		= sizeof(int),
+		.mode		= 0644,
+		.proc_handler	= kryonk_lock_handler,
+		.extra1		= SYSCTL_ZERO,
+		.extra2		= SYSCTL_ONE,
+	},
+};
+
+static int __init kryonk_lock_init(void)
+{
+	if (!register_sysctl("kernel/kryonk", kryonk_table))
+		pr_warn("kryonk: cannot register kernel.kryonk\n");
+	return 0;
+}
+late_initcall(kryonk_lock_init);
